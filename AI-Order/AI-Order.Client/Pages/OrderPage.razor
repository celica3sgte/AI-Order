@page "/{UserId}/{TableId}"
@page "/"
@using AI_Order.Client.Services
@using AI_Order.Shared.Models
@inject IOrderingService OrderingService
@inject ISpeechService SpeechService
@inject IJSRuntime JS
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>AI Order</PageTitle>

<div class="page-layout">

    <!-- Language toggle -->
    @if (_settings != null && (SecondaryLang != null || true))
    {
        <div class="lang-toggle-bar">
            <button class="lang-btn @(_lang == "primary" ? "lang-active" : "")" @onclick='() => SetLang("primary")'>
                @PrimaryLang.Flag @PrimaryLang.Code.ToUpper()
            </button>
            @if (SecondaryLang != null)
            {
                <button class="lang-btn @(_lang == "alt" ? "lang-active" : "")" @onclick='() => SetLang("alt")'>
                    @SecondaryLang.Flag @SecondaryLang.Code.ToUpper()
                </button>
            }
        </div>
    }

    <!-- Top: Menu + Order Panel -->
    <div class="top-row">

        <!-- Menu Area -->
        <div class="menu-area">
            @if (_menuLoading)
            {
                <div class="menu-loading">Loading menu...</div>
            }
            else
            {
                @foreach (var category in _menuItems.GroupBy(m => m.Category))
                {
                    <div class="menu-category">
                        <h3 class="category-title">@category.Key</h3>
                        <div class="menu-grid">
                            @foreach (var item in category)
                            {
                                var qty = _currentOrder?.LineItems.Where(li => li.MenuItemId == item.Id).Sum(li => li.Quantity) ?? 0;
                                <div class="menu-card @(qty > 0 ? "menu-card-selected" : "")" @onclick="() => OpenItemModal(item)">
                                    @if (!string.IsNullOrEmpty(item.MainImage))
                                    {
                                        <button class="menu-card-thumb" type="button"
                                                @onclick="() => OpenPreview(item)"
                                                @onclick:stopPropagation>
                                            <img src="@item.MainImage" alt="@item.Name" />
                                        </button>
                                    }
                                    <div class="menu-card-body">
                                        <span class="menu-card-name">@(_lang == "alt" && !string.IsNullOrEmpty(item.NameAlt) ? item.NameAlt : item.Name)</span>
                                        @{
                                            var displayDesc = _lang == "alt" && !string.IsNullOrEmpty(item.DescriptionAlt) ? item.DescriptionAlt : item.Description;
                                        }
                                        @if (!string.IsNullOrEmpty(displayDesc))
                                        {
                                            <span class="menu-card-desc">@displayDesc</span>
                                        }
                                    </div>
                                    <div class="menu-card-right">
                                        <span class="menu-card-price">$@item.Price.ToString("F2")</span>
                                        @if (qty > 0)
                                        {
                                            <span class="menu-card-qty">@qty</span>
                                        }
                                        else
                                        {
                                            <span class="menu-card-add">+</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Order Summary Panel -->
        <div class="order-panel">
            <div class="order-title-row">
                <h2 class="order-title">Your Order</h2>
                @if (!string.IsNullOrEmpty(_tableId))
                {
                    <span class="table-badge">@_tableId</span>
                }
            </div>

            @if (_currentOrder == null || !_currentOrder.LineItems.Any())
            {
                <div class="order-empty">
                    <p>Nothing added yet.</p>
                    <p class="order-hint">Tap a menu item or use chat to order!</p>
                </div>
            }
            else
            {
                <div class="order-items">
                    @foreach (var item in _currentOrder.LineItems)
                    {
                        <div class="order-item">
                            <div class="order-item-info">
                                <span class="order-item-name">@item.Name</span>
                                @if (item.SelectedModifiers.Any())
                                {
                                    <span class="order-item-mods">@string.Join(", ", item.SelectedModifiers)</span>
                                }
                                @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                {
                                    <span class="order-item-note">📝 @item.SpecialInstructions</span>
                                }
                            </div>
                            <div class="order-item-price">
                                <button class="btn-qty-remove" @onclick="() => RemoveItem(item)" title="Remove one">−</button>
                                <span class="qty">x@item.Quantity</span>
                                <span>$@item.LineTotal.ToString("F2")</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="order-totals">
                    <div class="total-row"><span>Subtotal</span><span>$@_currentOrder.Subtotal.ToString("F2")</span></div>
                    <div class="total-row"><span>Tax</span><span>$@_currentOrder.Tax.ToString("F2")</span></div>
                    <div class="total-row total-grand"><span>Total</span><span>$@_currentOrder.Total.ToString("F2")</span></div>
                </div>

                <button class="btn-submit"
                        @onclick="SubmitOrder"
                        disabled="@(_isSubmitting || _isStreaming)">
                    @(_isSubmitting ? "Submitting..." : "✅ Place Order")
                </button>

                @if (_submitResult != null)
                {
                    <div class="submit-result @(_submitResult.Success ? "success" : "error")">
                        @(_submitResult.Success
                            ? $"🎉 Order placed! ID: {_submitResult.SquareOrderId}"
                            : $"❌ {_submitResult.Message}")
                    </div>
                }
            }
        </div>
    </div>

    <!-- Bottom: Compact Chat Bar -->
    <div class="chat-bar">
        <div class="chat-messages-mini" id="chatMessages">
            @foreach (var msg in _messages)
            {
                <div class="mini-message @(msg.Role == "user" ? "mini-user" : "mini-assistant")">
                    <span class="mini-bubble">@msg.Content</span>
                </div>
            }
            @if (_isStreaming)
            {
                <div class="mini-message mini-assistant">
                    <span class="mini-bubble streaming">@_streamingText<span class="cursor">|</span></span>
                </div>
            }
        </div>

        <div class="chat-input-area">
            @if (_speechError != null)
            {
                <div class="speech-error">⚠️ @_speechError</div>
            }
            @if (_interimTranscript != null)
            {
                <div class="interim-transcript">🎤 @_interimTranscript</div>
            }
            <div class="input-row">
                <input class="chat-input"
                       placeholder="@InputPlaceholder"
                       @bind="_inputText"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       disabled="@(_isListening || _isStreaming)" />

                <button class="btn-mic @(_isListening ? "listening" : "")"
                        @onclick="ToggleListening"
                        title="@(_isListening ? "Stop listening" : "Speak your order")"
                        disabled="@_isStreaming">
                    @(_isListening ? "🔴" : "🎤")
                </button>

                <button class="btn-send"
                        @onclick="SendMessage"
                        disabled="@(string.IsNullOrWhiteSpace(_inputText) || _isStreaming)">
                    Send
                </button>
            </div>
        </div>
    </div>

</div>

@if (_previewItem is not null)
{
    var imgs = GetPreviewImages(_previewItem);
    <div class="img-preview-overlay" @onclick="ClosePreview">
        <div class="img-preview-modal" @onclick:stopPropagation>
            <div class="img-preview-header">
                <span class="img-preview-title">@_previewItem.Name</span>
                @if (imgs.Count > 1)
                {
                    <span class="img-preview-counter">@(_previewIndex + 1) / @imgs.Count</span>
                }
                <button class="img-preview-close" type="button" @onclick="ClosePreview">&times;</button>
            </div>
            <div class="img-preview-body">
                @if (imgs.Count > 1)
                {
                    <button class="img-preview-nav" type="button" @onclick="PrevImage">&#8249;</button>
                }
                <div class="img-preview-img-wrap">
                    <img src="@imgs[_previewIndex]" alt="@_previewItem.Name" />
                </div>
                @if (imgs.Count > 1)
                {
                    <button class="img-preview-nav" type="button" @onclick="NextImage">&#8250;</button>
                }
            </div>
        </div>
    </div>
}

@if (_itemModalItem is not null)
{
    var modalItem = _itemModalItem;
    var modalName = _lang == "alt" && !string.IsNullOrEmpty(modalItem.NameAlt) ? modalItem.NameAlt : modalItem.Name;
    var modalDesc = _lang == "alt" && !string.IsNullOrEmpty(modalItem.DescriptionAlt) ? modalItem.DescriptionAlt : modalItem.Description;
    <div class="item-modal-overlay" @onclick="CloseItemModal">
        <div class="item-modal" @onclick:stopPropagation>
            <div class="item-modal-header">
                <div class="item-modal-header-info">
                    <div class="item-modal-title">@modalName</div>
                    <div class="item-modal-price">$@modalItem.Price.ToString("F2")</div>
                </div>
                <button class="item-modal-close" type="button" @onclick="CloseItemModal">&times;</button>
            </div>
            <div class="item-modal-body">
                @if (!string.IsNullOrEmpty(modalItem.MainImage))
                {
                    <img src="@modalItem.MainImage" alt="@modalItem.Name" class="item-modal-img" />
                }
                @if (!string.IsNullOrEmpty(modalDesc))
                {
                    <p class="item-modal-desc">@modalDesc</p>
                }
                @{
                    var modalIngredients = _lang == "alt" && modalItem.IngredientsAlt.Any()
                        ? modalItem.IngredientsAlt
                        : modalItem.Ingredients;
                }
                @if (modalIngredients.Any())
                {
                    <div class="item-ingredients">
                        <div class="item-ingredients-title">Ingredients</div>
                        <div class="item-ingredients-list">
                            @foreach (var ing in modalIngredients)
                            {
                                <span class="item-ingredient-chip">@ing</span>
                            }
                        </div>
                    </div>
                }
                @for (int gi = 0; gi < modalItem.ModifierGroups.Count; gi++)
                {
                    var grp = modalItem.ModifierGroups[gi];
                    var gIdx = gi;
                    var grpName = _lang == "alt" && !string.IsNullOrEmpty(grp.NameAlt) ? grp.NameAlt : grp.Name;
                    <div class="modifier-group">
                        <div class="modifier-group-title">
                            @grpName
                            @if (grp.Required)
                            {
                                <span class="modifier-required-badge">Required</span>
                            }
                        </div>
                        @for (int oi = 0; oi < grp.Options.Count; oi++)
                        {
                            var opt = grp.Options[oi];
                            var oIdx = oi;
                            var optName = _lang == "alt" && !string.IsNullOrEmpty(opt.NameAlt) ? opt.NameAlt : opt.Name;
                            @if (grp.Required)
                            {
                                <label class="modifier-option">
                                    <input type="radio"
                                           name="mod-@modalItem.Id-@gIdx"
                                           checked="@(_selectedRequired.GetValueOrDefault(gIdx, -1) == oIdx)"
                                           @onchange="() => SelectRequired(gIdx, oIdx)" />
                                    <span class="modifier-option-name">@optName</span>
                                    @if (opt.PriceModifier != 0)
                                    {
                                        <span class="modifier-option-price">@FormatModPrice(opt.PriceModifier)</span>
                                    }
                                </label>
                            }
                            else
                            {
                                <label class="modifier-option">
                                    <input type="checkbox"
                                           checked="@_selectedOptional.Contains((gIdx, oIdx))"
                                           @onchange="e => ToggleOptional(gIdx, oIdx, e.Value is bool b && b)" />
                                    <span class="modifier-option-name">@optName</span>
                                    @if (opt.PriceModifier != 0)
                                    {
                                        <span class="modifier-option-price">@FormatModPrice(opt.PriceModifier)</span>
                                    }
                                </label>
                            }
                        }
                    </div>
                }
                <div class="special-instructions-section">
                    <label class="special-instructions-label">Special Instructions</label>
                    <textarea class="special-instructions-input" rows="2"
                              placeholder="Any special requests..."
                              @bind="_specialInstructions"
                              @bind:event="oninput"></textarea>
                </div>
            </div>
            <div class="item-modal-footer">
                <button class="btn-item-cancel" type="button" @onclick="CloseItemModal">Cancel</button>
                <div class="item-modal-qty">
                    <button class="item-modal-qty-btn" type="button"
                            @onclick="DecreaseQty" disabled="@(_itemQty <= 1)">−</button>
                    <span class="item-modal-qty-val">@_itemQty</span>
                    <button class="item-modal-qty-btn" type="button" @onclick="IncreaseQty">+</button>
                </div>
                <button class="btn-item-add" type="button"
                        @onclick="ConfirmAddItem" disabled="@HasUnsatisfiedRequired">
                    Add to Order · $@((ModalUnitPrice() * _itemQty).ToString("F2"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? UserId { get; set; }
    [Parameter] public string? TableId { get; set; }

    private List<ChatMessageDto> _messages = [];
    private List<MenuItemDto> _menuItems = [];
    private bool _menuLoading = true;
    private OrderDto? _currentOrder;
    private string _tableId = string.Empty;
    private string _inputText = string.Empty;

    private MenuItemDto? _previewItem;
    private int _previewIndex;

    private MenuItemDto? _itemModalItem;
    private int _itemQty = 1;
    private readonly Dictionary<int, int> _selectedRequired = new();
    private readonly HashSet<(int g, int o)> _selectedOptional = new();
    private string _specialInstructions = string.Empty;

    private string _lang = "primary";
    private RestaurantSettingsDto? _settings;
    private LanguageInfo PrimaryLang => LanguageDefinitions.Get(_settings?.PrimaryLanguageCode);
    private LanguageInfo? SecondaryLang => string.IsNullOrEmpty(_settings?.SecondaryLanguageCode) ? null : LanguageDefinitions.Get(_settings.SecondaryLanguageCode);
    private string SpeechLang => _lang == "alt" && SecondaryLang != null ? SecondaryLang.SpeechCode : PrimaryLang.SpeechCode;
    private string InputPlaceholder => _lang == "alt" && SecondaryLang != null ? SecondaryLang.Placeholder : PrimaryLang.Placeholder;

    private void SetLang(string lang) => _lang = lang;
    private string _streamingText = string.Empty;
    private string? _interimTranscript;
    private string? _speechError;
    private bool _isStreaming;
    private bool _isListening;
    private bool _isSubmitting;
    private SubmitOrderResponseDto? _submitResult;
    private DotNetObjectReference<OrderPage>? _selfRef;
    private CancellationTokenSource? _streamCts;

    protected override async Task OnInitializedAsync()
    {
        _selfRef = DotNetObjectReference.Create(this);

        if (!string.IsNullOrEmpty(TableId))
        {
            _tableId = TableId;
        }
        else
        {
            var uri = new Uri(NavManager.Uri);
            var queryParams = uri.Query.TrimStart('?')
                .Split('&', StringSplitOptions.RemoveEmptyEntries)
                .Select(p => p.Split('=', 2))
                .Where(p => p.Length == 2)
                .ToDictionary(p => Uri.UnescapeDataString(p[0]), p => Uri.UnescapeDataString(p[1]));
            _tableId = queryParams.TryGetValue("table", out var tableValue) ? tableValue : "table-1";
        }

        _messages.Add(new ChatMessageDto
        {
            Role = "assistant",
            Content = "What can I get for you?"
        });

        try
        {
            var menuTask = OrderingService.GetMenuAsync(UserId);
            var settingsTask = OrderingService.GetSettingsAsync(UserId);
            await Task.WhenAll(menuTask, settingsTask);
            _menuItems = menuTask.Result;
            _settings = settingsTask.Result;
        }
        catch { }
        finally
        {
            _menuLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("eval",
            "var el = document.getElementById('chatMessages'); if(el) el.scrollTop = el.scrollHeight;");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_inputText))
            await SendMessage();
    }

    private async Task SendMessage()
    {
        var text = _inputText.Trim();
        if (string.IsNullOrEmpty(text)) return;

        _inputText = string.Empty;
        _messages.Add(new ChatMessageDto { Role = "user", Content = text });
        _isStreaming = true;
        _streamingText = string.Empty;
        StateHasChanged();

        var request = new ChatRequestDto
        {
            Messages = _messages.Where(m => m.Role is "user" or "assistant").ToList(),
            CurrentOrder = _currentOrder,
            UserId = UserId
        };

        _streamCts = new CancellationTokenSource();
        var fullResponse = new System.Text.StringBuilder();

        try
        {
            await foreach (var chunk in OrderingService.ChatStreamAsync(request, _streamCts.Token))
            {
                fullResponse.Append(chunk);
                _streamingText = fullResponse.ToString();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessageDto { Role = "assistant", Content = $"⚠️ Error: {ex.Message}" });
            _streamingText = string.Empty;
            _isStreaming = false;
            StateHasChanged();
            return;
        }

        var finalText = fullResponse.ToString();

        // Parse out order JSON from the full response
        var orderUpdate = TryExtractOrder(finalText);
        if (orderUpdate != null) _currentOrder = orderUpdate;
        var cleanText = StripOrderJson(finalText);

        _messages.Add(new ChatMessageDto { Role = "assistant", Content = cleanText });
        _streamingText = string.Empty;
        _isStreaming = false;

        // Speak the response
        await SpeechService.SpeakAsync(cleanText, SpeechLang);

        StateHasChanged();
    }

    private async Task ToggleListening()
    {
        if (_isListening)
        {
            await SpeechService.StopListeningAsync();
            _isListening = false;
        }
        else
        {
            _speechError = null;
            await SpeechService.StartListeningAsync(
                DotNetObjectReference.Create((object)this), SpeechLang);
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void OnListeningStarted()
    {
        _isListening = true;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnListeningEnded()
    {
        _isListening = false;
        _interimTranscript = null;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnSpeechResult(string transcript, bool isFinal)
    {
        if (isFinal)
        {
            _inputText = transcript;
            _interimTranscript = null;
            await InvokeAsync(async () =>
            {
                StateHasChanged();
                await SendMessage();
            });
        }
        else
        {
            _interimTranscript = transcript;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public void OnSpeechError(string error)
    {
        _speechError = error;
        _isListening = false;
        InvokeAsync(StateHasChanged);
    }

    private static List<string> GetPreviewImages(MenuItemDto item) =>
        new[] { item.MainImage, item.Image1, item.Image2, item.Image3 }
            .Where(u => !string.IsNullOrEmpty(u))
            .ToList()!;

    private void OpenPreview(MenuItemDto item)
    {
        _previewItem = item;
        _previewIndex = 0;
    }

    private void ClosePreview()
    {
        _previewItem = null;
        _previewIndex = 0;
    }

    private void PrevImage()
    {
        if (_previewItem is null) return;
        var count = GetPreviewImages(_previewItem).Count;
        _previewIndex = (_previewIndex - 1 + count) % count;
    }

    private void NextImage()
    {
        if (_previewItem is null) return;
        var count = GetPreviewImages(_previewItem).Count;
        _previewIndex = (_previewIndex + 1) % count;
    }

    private bool HasUnsatisfiedRequired
    {
        get
        {
            if (_itemModalItem is null) return false;
            for (int i = 0; i < _itemModalItem.ModifierGroups.Count; i++)
                if (_itemModalItem.ModifierGroups[i].Required &&
                    (!_selectedRequired.TryGetValue(i, out var v) || v < 0))
                    return true;
            return false;
        }
    }

    private decimal ModalUnitPrice()
    {
        if (_itemModalItem is null) return 0;
        decimal price = _itemModalItem.Price;
        var grps = _itemModalItem.ModifierGroups;
        foreach (var (gi, oi) in _selectedRequired)
            if (oi >= 0 && gi < grps.Count && oi < grps[gi].Options.Count)
                price += grps[gi].Options[oi].PriceModifier;
        foreach (var (gi, oi) in _selectedOptional)
            if (gi < grps.Count && oi < grps[gi].Options.Count)
                price += grps[gi].Options[oi].PriceModifier;
        return price;
    }

    private static string FormatModPrice(decimal price)
        => price >= 0 ? $"+${price:F2}" : $"-${-price:F2}";

    private void OpenItemModal(MenuItemDto item)
    {
        _itemModalItem = item;
        _itemQty = 1;
        _selectedRequired.Clear();
        _selectedOptional.Clear();
        _specialInstructions = string.Empty;
        for (int i = 0; i < item.ModifierGroups.Count; i++)
            if (item.ModifierGroups[i].Required)
                _selectedRequired[i] = -1;
    }

    private void CloseItemModal() => _itemModalItem = null;
    private void SelectRequired(int gi, int oi) => _selectedRequired[gi] = oi;
    private void ToggleOptional(int gi, int oi, bool selected)
    {
        if (selected) _selectedOptional.Add((gi, oi));
        else _selectedOptional.Remove((gi, oi));
    }
    private void DecreaseQty() { if (_itemQty > 1) _itemQty--; }
    private void IncreaseQty() => _itemQty++;

    private void ConfirmAddItem()
    {
        if (_itemModalItem is null) return;
        var unitPrice = ModalUnitPrice();
        var mods = new List<string>();
        var grps = _itemModalItem.ModifierGroups;
        foreach (var (gi, oi) in _selectedRequired.OrderBy(x => x.Key))
            if (oi >= 0 && gi < grps.Count && oi < grps[gi].Options.Count)
                mods.Add($"{grps[gi].Name}: {grps[gi].Options[oi].Name}");
        foreach (var (gi, oi) in _selectedOptional.OrderBy(x => x.g))
            if (gi < grps.Count && oi < grps[gi].Options.Count)
                mods.Add($"{grps[gi].Name}: {grps[gi].Options[oi].Name}");

        _currentOrder ??= new OrderDto { Id = Guid.NewGuid().ToString(), Status = OrderStatus.Draft };
        _currentOrder.LineItems.Add(new OrderLineItemDto
        {
            MenuItemId = _itemModalItem.Id,
            Name = _itemModalItem.Name,
            Quantity = _itemQty,
            UnitPrice = unitPrice,
            LineTotal = unitPrice * _itemQty,
            SelectedModifiers = mods,
            SpecialInstructions = string.IsNullOrWhiteSpace(_specialInstructions) ? null : _specialInstructions.Trim()
        });

        RecalculateTotals();
        CloseItemModal();
        StateHasChanged();
    }

    private void AddItem(MenuItemDto item)
    {
        _currentOrder ??= new OrderDto { Id = Guid.NewGuid().ToString(), Status = OrderStatus.Draft };

        var existing = _currentOrder.LineItems.FirstOrDefault(li => li.MenuItemId == item.Id);
        if (existing is not null)
        {
            existing.Quantity++;
            existing.LineTotal = existing.UnitPrice * existing.Quantity;
        }
        else
        {
            _currentOrder.LineItems.Add(new OrderLineItemDto
            {
                MenuItemId = item.Id,
                Name = item.Name,
                Quantity = 1,
                UnitPrice = item.Price,
                LineTotal = item.Price
            });
        }

        RecalculateTotals();
        StateHasChanged();
    }

    private void RemoveItem(OrderLineItemDto item)
    {
        if (_currentOrder is null) return;
        if (item.Quantity > 1)
        {
            item.Quantity--;
            item.LineTotal = item.UnitPrice * item.Quantity;
        }
        else
        {
            _currentOrder.LineItems.Remove(item);
        }
        RecalculateTotals();
        StateHasChanged();
    }

    private void RecalculateTotals()
    {
        if (_currentOrder is null) return;
        _currentOrder.Subtotal = _currentOrder.LineItems.Sum(li => li.LineTotal);
        _currentOrder.Tax = Math.Round(_currentOrder.Subtotal * 0.0825m, 2);
        _currentOrder.Total = _currentOrder.Subtotal + _currentOrder.Tax;
    }

    private async Task SubmitOrder()
    {
        if (_currentOrder == null) return;
        _isSubmitting = true;
        _submitResult = null;
        StateHasChanged();

        var request = new SubmitOrderRequestDto
        {
            Order = _currentOrder,
            TableId = _tableId,
            AspNetUserId = UserId
        };
        _submitResult = await OrderingService.SubmitOrderAsync(request);
        _isSubmitting = false;

        if (_submitResult.Success)
        {
            _currentOrder = null;
            _messages.Add(new ChatMessageDto
            {
                Role = "assistant",
                Content = $"🎉 Your order has been sent to the kitchen! Order ID: {_submitResult.SquareOrderId}. Thank you!"
            });
        }

        StateHasChanged();
    }

    private static OrderDto? TryExtractOrder(string message)
    {
        var start = message.IndexOf("<order>", StringComparison.OrdinalIgnoreCase);
        var end = message.IndexOf("</order>", StringComparison.OrdinalIgnoreCase);
        if (start == -1 || end == -1) return null;

        var json = message[(start + 7)..end].Trim();
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var payload = System.Text.Json.JsonSerializer.Deserialize<OrderPayload>(json, opts);
            if (payload?.LineItems == null) return null;

            decimal subtotal = payload.LineItems.Sum(li => li.UnitPrice * li.Quantity);
            decimal tax = subtotal * 0.0825m;

            return new OrderDto
            {
                Id = Guid.NewGuid().ToString(),
                LineItems = payload.LineItems.Select(li => new OrderLineItemDto
                {
                    MenuItemId = li.MenuItemId,
                    Name = li.Name,
                    Quantity = li.Quantity,
                    UnitPrice = li.UnitPrice,
                    LineTotal = li.UnitPrice * li.Quantity,
                    SelectedModifiers = li.SelectedModifiers ?? [],
                    SpecialInstructions = li.SpecialInstructions
                }).ToList(),
                Subtotal = subtotal,
                Tax = tax,
                Total = subtotal + tax,
                Status = OrderStatus.Draft
            };
        }
        catch { return null; }
    }

    private static string StripOrderJson(string message)
    {
        var start = message.IndexOf("<order>", StringComparison.OrdinalIgnoreCase);
        var end = message.IndexOf("</order>", StringComparison.OrdinalIgnoreCase);
        if (start == -1 || end == -1) return message;
        return (message[..start] + message[(end + 8)..]).Trim();
    }

    private class OrderPayload
    {
        public List<LineItemPayload>? LineItems { get; set; }
    }
    private class LineItemPayload
    {
        public string MenuItemId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public List<string>? SelectedModifiers { get; set; }
        public string? SpecialInstructions { get; set; }
    }

    public void Dispose()
    {
        _selfRef?.Dispose();
        _streamCts?.Cancel();
        _streamCts?.Dispose();
    }
}
