@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@using AI_Order.Shared.Models
@using AI_Order.Management.Services
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using System.Net.Http.Json
@using System.Text.Json
@inject AuthenticationStateProvider AuthStateProvider
@inject OrderNotificationService NotificationService
@inject SignalRClientService SignalRClient
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Orders Dashboard</PageTitle>

<div class="page-banner">
    <div class="page-banner-left">
        <span class="badge @(SignalRClient.IsConnected ? "bg-success" : "bg-warning text-dark")">
            @(SignalRClient.IsConnected ? "● Live" : "Connecting...")
        </span>
    </div>
    <div class="page-banner-center">
        <h1 class="page-banner-title">Dashboard</h1>
    </div>
    <div class="page-banner-right d-flex gap-2">
        <div class="btn-group btn-group-sm" role="group">
            <button class="btn @(_tableView ? "btn-outline-light" : "btn-light")" @onclick="() => _tableView = false" title="Card view">
                ⊞ Card
            </button>
            <button class="btn @(_tableView ? "btn-light" : "btn-outline-light")" @onclick="() => _tableView = true" title="Table view">
                ☰ Table
            </button>
        </div>
        @if (!_isFullscreen)
        {
            <button class="btn btn-sm btn-outline-light" @onclick="GoFullscreen" title="Fullscreen">
                ⛶ Fullscreen
            </button>
        }
    </div>
</div>

<div class="container-fluid py-3">

    @if (_initError is not null)
    {
        <div class="alert alert-danger">@_initError</div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (!_tableGroups.Any())
    {
        <div class="text-center text-muted py-5">
            <p class="fs-5">No active orders. New orders will appear here in real-time.</p>
        </div>
    }
    else if (!_tableView)
    {
        <div class="row g-4">
            @foreach (var table in _tableGroups)
            {
                <div class="col-12 col-lg-6 col-xl-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header card-header-gradient d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 text-capitalize text-white">@table.Key</h5>
                            <span class="badge bg-white text-dark">@table.Value.Count order(s)</span>
                        </div>
                        <div class="card-body p-0">
                            @foreach (var order in table.Value.OrderByDescending(o => o.CreatedAt))
                            {
                                <div class="border-bottom p-3 @RowClass(order.Status)">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <small class="text-muted">@order.CreatedAt.ToLocalTime().ToString("hh:mm tt")</small>
                                        <span class="badge @BadgeClass(order.Status)">@order.Status</span>
                                    </div>
                                    <ul class="list-unstyled mb-2 small">
                                        @foreach (var item in order.LineItems)
                                        {
                                            <li>
                                                <div class="d-flex justify-content-between">
                                                    <span>
                                                        <span class="fw-semibold">@item.Quantity×</span> @item.Name
                                                        @if (item.SelectedModifiers.Any())
                                                        {
                                                            <span class="text-muted"> (@string.Join(", ", item.SelectedModifiers))</span>
                                                        }
                                                    </span>
                                                    <span class="text-muted ms-2">$@item.LineTotal.ToString("F2")</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(item.SpecialInstructions))
                                                {
                                                    <div class="text-muted fst-italic" style="font-size:0.78rem;">📝 @item.SpecialInstructions</div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                    @if (!string.IsNullOrWhiteSpace(order.SpecialInstructions))
                                    {
                                        <p class="small fst-italic text-muted mb-2">Note: @order.SpecialInstructions</p>
                                    }
                                    <div class="order-totals small text-muted mb-2">
                                        <div class="d-flex justify-content-between">
                                            <span>Subtotal</span>
                                            <span>$@order.Subtotal.ToString("F2")</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Tax</span>
                                            <span>$@order.Tax.ToString("F2")</span>
                                        </div>
                                        <div class="d-flex justify-content-between fw-semibold text-dark border-top pt-1 mt-1">
                                            <span>Total</span>
                                            <span>$@order.Total.ToString("F2")</span>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end">
                                        <div class="btn-group btn-group-sm">
                                            @if (order.Status == OrderStatus.Submitted)
                                            {
                                                <button class="btn btn-outline-warning"
                                                        @onclick="() => UpdateStatusAsync(order, OrderStatus.InProgress)">
                                                    Start
                                                </button>
                                            }
                                            @if (order.Status == OrderStatus.InProgress)
                                            {
                                                <button class="btn btn-outline-info"
                                                        @onclick="() => UpdateStatusAsync(order, OrderStatus.Ready)">
                                                    Ready
                                                </button>
                                            }
                                            @if (order.Status is OrderStatus.InProgress or OrderStatus.Ready)
                                            {
                                                <button class="btn btn-outline-success"
                                                        @onclick="() => UpdateStatusAsync(order, OrderStatus.Completed)">
                                                    Complete
                                                </button>
                                            }
                                            <button class="btn btn-outline-danger"
                                                    @onclick="() => UpdateStatusAsync(order, OrderStatus.Cancelled)">
                                                Cancel
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0 dashboard-table">
                <thead>
                    <tr class="dashboard-table-header">
                        <th style="width:12%">Area</th>
                        <th style="width:14%">Status</th>
                        <th>Orders</th>
                        <th style="width:18%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var table in _tableGroups)
                    {
                        var orders = table.Value.OrderByDescending(o => o.CreatedAt).ToList();
                        for (int i = 0; i < orders.Count; i++)
                        {
                            var order = orders[i];
                            <tr>
                                @if (i == 0)
                                {
                                    <td rowspan="@orders.Count" class="fw-semibold text-capitalize align-middle text-center">
                                        @table.Key
                                        @if (orders.Count > 1)
                                        {
                                            <div><span class="badge bg-secondary mt-1">@orders.Count orders</span></div>
                                        }
                                    </td>
                                }
                                <td class="align-middle @RowClass(order.Status)">
                                    <span class="badge @BadgeClass(order.Status)">@order.Status</span>
                                    <div class="text-muted small mt-1">@order.CreatedAt.ToLocalTime().ToString("hh:mm tt")</div>
                                </td>
                                <td class="@RowClass(order.Status)">
                                    @if (!string.IsNullOrWhiteSpace(order.CustomerName))
                                    {
                                        <div class="small fw-semibold mb-1">@order.CustomerName</div>
                                    }
                                    <table class="table table-sm table-borderless mb-1 nested-order-table">
                                        <tbody>
                                            @foreach (var item in order.LineItems)
                                            {
                                                <tr>
                                                    <td class="py-0">
                                                        <span class="fw-semibold">@item.Quantity×</span> @item.Name
                                                        @if (item.SelectedModifiers.Any())
                                                        {
                                                            <span class="text-muted"> (@string.Join(", ", item.SelectedModifiers))</span>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(item.SpecialInstructions))
                                                        {
                                                            <div class="text-muted fst-italic" style="font-size:0.78rem;">📝 @item.SpecialInstructions</div>
                                                        }
                                                    </td>
                                                    <td class="py-0 text-end text-muted" style="width:80px">$@item.LineTotal.ToString("F2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="border-top">
                                            <tr class="text-muted small">
                                                <td class="py-0">Subtotal</td>
                                                <td class="py-0 text-end">$@order.Subtotal.ToString("F2")</td>
                                            </tr>
                                            <tr class="text-muted small">
                                                <td class="py-0">Tax</td>
                                                <td class="py-0 text-end">$@order.Tax.ToString("F2")</td>
                                            </tr>
                                            <tr class="fw-semibold">
                                                <td class="py-0">Total</td>
                                                <td class="py-0 text-end">$@order.Total.ToString("F2")</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                    @if (!string.IsNullOrWhiteSpace(order.SpecialInstructions))
                                    {
                                        <p class="small fst-italic text-muted mb-0">Note: @order.SpecialInstructions</p>
                                    }
                                </td>
                                <td class="align-middle @RowClass(order.Status)">
                                    <div class="btn-group btn-group-sm">
                                        @if (order.Status == OrderStatus.Submitted)
                                        {
                                            <button class="btn btn-outline-warning"
                                                    @onclick="() => UpdateStatusAsync(order, OrderStatus.InProgress)">
                                                Start
                                            </button>
                                        }
                                        @if (order.Status == OrderStatus.InProgress)
                                        {
                                            <button class="btn btn-outline-info"
                                                    @onclick="() => UpdateStatusAsync(order, OrderStatus.Ready)">
                                                Ready
                                            </button>
                                        }
                                        @if (order.Status is OrderStatus.InProgress or OrderStatus.Ready)
                                        {
                                            <button class="btn btn-outline-success"
                                                    @onclick="() => UpdateStatusAsync(order, OrderStatus.Completed)">
                                                Complete
                                            </button>
                                        }
                                        <button class="btn btn-outline-danger"
                                                @onclick="() => UpdateStatusAsync(order, OrderStatus.Cancelled)">
                                            Cancel
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };

    private string _userId = "";
    private bool _isLoading = true;
    private bool _isFullscreen;
    private bool _tableView;
    private string? _initError;
    private readonly Dictionary<string, List<TableOrder>> _tableGroups = new();
    private HttpClient _api = null!;
    private DotNetObjectReference<Dashboard>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        _api = HttpClientFactory.CreateClient("Api");
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        NotificationService.OnOrderUpdated += HandleOrderUpdated;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("registerFullscreenListener", _selfRef);
        _ = SignalRClient.StartAsync(_userId);
        await RefreshAsync();
    }

    [JSInvokable]
    public void OnFullscreenChanged(bool isFullscreen)
    {
        _isFullscreen = isFullscreen;
        InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var orders = await _api.GetFromJsonAsync<List<TableOrder>>(
                $"api/orders/byuser/{_userId}", _jsonOptions) ?? [];
            _tableGroups.Clear();
            foreach (var order in orders.Where(o => o.Status is not OrderStatus.Completed and not OrderStatus.Cancelled))
            {
                if (!_tableGroups.TryGetValue(order.TableId, out var list))
                    _tableGroups[order.TableId] = list = new();
                list.Add(order);
            }
        }
        catch (Exception ex)
        {
            _initError = ex.Message;
            Console.Error.WriteLine($"[Dashboard] RefreshAsync error: {ex}");
        }
        _isLoading = false;
        StateHasChanged();
    }

    private async void HandleOrderUpdated(string userId)
    {
        if (userId != _userId) return;
        try { await InvokeAsync(RefreshAsync); }
        catch (Exception ex) { Console.WriteLine($"[Dashboard] HandleOrderUpdated error: {ex.Message}"); }
    }

    private async Task UpdateStatusAsync(TableOrder order, OrderStatus newStatus)
    {
        using var resp = await _api.PatchAsJsonAsync(
            $"api/orders/{order.Id}/status",
            new UpdateOrderStatusRequest { AspNetUserId = _userId, Status = newStatus });
        if (!resp.IsSuccessStatusCode) return;

        order.Status = newStatus;
        if (newStatus is OrderStatus.Completed or OrderStatus.Cancelled)
        {
            _tableGroups[order.TableId].Remove(order);
            if (!_tableGroups[order.TableId].Any())
                _tableGroups.Remove(order.TableId);
        }
        StateHasChanged();
    }

    private async Task GoFullscreen()
    {
        await JS.InvokeVoidAsync("openFullscreen");
    }

    private static string BadgeClass(OrderStatus s) => s switch
    {
        OrderStatus.Submitted  => "bg-secondary",
        OrderStatus.InProgress => "bg-warning text-dark",
        OrderStatus.Ready      => "bg-info text-dark",
        OrderStatus.Completed  => "bg-success",
        _                      => "bg-light text-dark"
    };

    private static string RowClass(OrderStatus s) => s switch
    {
        OrderStatus.InProgress => "bg-warning bg-opacity-10",
        OrderStatus.Ready      => "bg-info bg-opacity-10",
        _                      => ""
    };

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        NotificationService.OnOrderUpdated -= HandleOrderUpdated;
        await SignalRClient.StopAsync();
    }
}
