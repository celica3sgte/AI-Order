@page "/menu"
@attribute [Authorize]
@rendermode InteractiveServer
@using AI_Order.Management.Data
@using AI_Order.Management.Services
@using AI_Order.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using System.Text.Json
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject BlobStorageService BlobStorage
@inject IJSRuntime JS

<PageTitle>Menu</PageTitle>

<div class="page-banner">
    <div class="page-banner-left"></div>
    <div class="page-banner-center">
        <h1 class="page-banner-title">Menu</h1>
        <p class="page-banner-sub">Manage your restaurant's menu items</p>
    </div>
    <div class="page-banner-right">
        <button class="btn btn-sm btn-light" @onclick="OpenNew">+ Add Item</button>
    </div>
</div>

<div class="container-fluid py-4">

    @if (_error is not null)
    {
        <div class="alert alert-danger alert-dismissible">
            @_error
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else if (!_items.Any())
    {
        <div class="text-center text-muted py-5">
            <p class="fs-5">No menu items yet. Click <strong>Add Item</strong> to create your first item.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th style="width:60px" class="text-center">Main</th>
                        <th style="width:60px" class="text-center">Img 2</th>
                        <th style="width:60px" class="text-center">Img 3</th>
                        <th style="width:60px" class="text-center">Img 4</th>
                        <th>Price</th>
                        <th>Available</th>
                        <th style="width:130px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items.OrderBy(i => i.Category).ThenBy(i => i.Name))
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.Name</div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <small class="text-muted">@item.Description</small>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@item.Category</span></td>
                            @foreach (var imgUrl in new[] { item.MainImage, item.Image1, item.Image2, item.Image3 })
                            {
                                <td class="text-center" style="width:60px">
                                    @if (!string.IsNullOrEmpty(imgUrl))
                                    {
                                        var capturedUrl = imgUrl;
                                        <button type="button" class="btn p-0 border-0 bg-transparent"
                                                title="Click to preview" @onclick="() => _previewUrl = capturedUrl">
                                            <img src="@capturedUrl" alt="preview"
                                                 style="width:44px;height:44px;object-fit:cover;border-radius:4px;border:1px solid #dee2e6;cursor:pointer;" />
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size:0.7rem;">—</span>
                                    }
                                </td>
                            }
                            <td>$@item.Price.ToString("F2")</td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" @onclick="() => OpenEdit(item)">Edit</button>
                                    @if (_confirmDeleteId == item.Id)
                                    {
                                        <button class="btn btn-danger" @onclick="() => DeleteAsync(item.Id)">Confirm</button>
                                        <button class="btn btn-outline-secondary" @onclick="() => _confirmDeleteId = null">✕</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-danger" @onclick="() => _confirmDeleteId = item.Id">Delete</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_previewUrl is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.75)"
         @onclick="() => _previewUrl = null">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title mb-0">Image Preview</h6>
                    <button type="button" class="btn-close" @onclick="() => _previewUrl = null"></button>
                </div>
                <div class="modal-body p-2 text-center bg-dark">
                    <img src="@_previewUrl" alt="Preview"
                         style="max-width:100%;max-height:75vh;object-fit:contain;" />
                </div>
            </div>
        </div>
    </div>
}

@if (_showModal && _editItem is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header card-header-gradient">
                    <h5 class="modal-title text-white">@(_isNew ? "New Menu Item" : _editItem.Name)</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">

                    @* ── Basic Info ── *@
                    <h6 class="text-uppercase text-muted fw-bold mb-3">Basic Info</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_editItem.Name" placeholder="e.g. Classic Burger" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Price <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input class="form-control" type="number" step="0.01" min="0"
                                       @bind="_editItem.Price" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Category <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_editItem.Category" placeholder="e.g. Burgers" list="category-suggestions" />
                            <datalist id="category-suggestions">
                                @foreach (var cat in _existingCategories)
                                {
                                    <option value="@cat" />
                                }
                            </datalist>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="2" @bind="_editItem.Description"
                                      placeholder="Brief description shown to customers"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk-available"
                                       @bind="_editItem.IsAvailable" />
                                <label class="form-check-label" for="chk-available">Available for ordering</label>
                            </div>
                        </div>
                    </div>

                    <hr />

                    @* ── Ingredients ── *@
                    <h6 class="text-uppercase text-muted fw-bold mb-3">Ingredients</h6>
                    <div class="mb-4">
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @foreach (var ing in _editItem.Ingredients)
                            {
                                <span class="badge bg-light text-dark border d-flex align-items-center gap-1">
                                    @ing
                                    <button type="button" class="btn-close btn-close" style="font-size:0.6rem"
                                            @onclick="() => _editItem.Ingredients.Remove(ing)"></button>
                                </span>
                            }
                        </div>
                        <div class="input-group" style="max-width:350px">
                            <input class="form-control form-control-sm" placeholder="Add ingredient..."
                                   @bind="_newIngredient" @bind:event="oninput"
                                   @onkeydown="@(e => { if (e.Key == "Enter") AddIngredient(); })" />
                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="AddIngredient">Add</button>
                        </div>
                    </div>

                    <hr />

                    @* ── Allergens ── *@
                    <h6 class="text-uppercase text-muted fw-bold mb-3">Allergens</h6>
                    <div class="mb-4">
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @foreach (var allergen in _commonAllergens)
                            {
                                var active = _editItem.Allergens.Contains(allergen);
                                <button type="button"
                                        class="btn btn-sm @(active ? "btn-warning" : "btn-outline-secondary")"
                                        @onclick="() => ToggleAllergen(allergen)">
                                    @allergen
                                </button>
                            }
                        </div>
                        <div class="input-group mt-2" style="max-width:350px">
                            <input class="form-control form-control-sm" placeholder="Add custom allergen..."
                                   @bind="_newAllergen" @bind:event="oninput"
                                   @onkeydown="@(e => { if (e.Key == "Enter") AddAllergen(); })" />
                            <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="AddAllergen">Add</button>
                        </div>
                    </div>

                    <hr />

                    @* ── Modifier Groups ── *@
                    <h6 class="text-uppercase text-muted fw-bold mb-3">Modifier Groups</h6>
                    <div class="mb-4">
                        @for (int gi = 0; gi < _editItem.ModifierGroups.Count; gi++)
                        {
                            var g = _editItem.ModifierGroups[gi];
                            var groupIndex = gi;
                            <div class="card mb-3">
                                <div class="card-header d-flex align-items-center gap-2 py-2">
                                    <input class="form-control form-control-sm" style="max-width:220px"
                                           placeholder="Group name (e.g. Doneness)"
                                           value="@g.Name"
                                           @oninput="e => g.Name = e.Value?.ToString() ?? string.Empty" />
                                    <div class="form-check form-switch mb-0 ms-2">
                                        <input class="form-check-input" type="checkbox" id="req-@gi"
                                               checked="@g.Required"
                                               @onchange="e => g.Required = (bool)(e.Value ?? false)" />
                                        <label class="form-check-label small" for="req-@gi">Required</label>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-auto"
                                            @onclick="() => _editItem.ModifierGroups.RemoveAt(groupIndex)">
                                        Remove Group
                                    </button>
                                </div>
                                <div class="card-body py-2">
                                    @foreach (var opt in g.Options.ToList())
                                    {
                                        var o = opt;
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <input class="form-control form-control-sm" style="max-width:200px"
                                                   placeholder="Option name"
                                                   value="@o.Name"
                                                   @oninput="e => o.Name = e.Value?.ToString() ?? string.Empty" />
                                            <div class="input-group input-group-sm" style="max-width:130px">
                                                <span class="input-group-text">+$</span>
                                                <input class="form-control" type="number" step="0.01" min="0"
                                                       value="@o.PriceModifier"
                                                       @oninput="e => { if (decimal.TryParse(e.Value?.ToString(), out var p)) o.PriceModifier = p; }" />
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => g.Options.Remove(o)">✕</button>
                                        </div>
                                    }
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <input class="form-control form-control-sm" style="max-width:200px"
                                               placeholder="New option name..."
                                               @bind="_newOptName[groupIndex]" @bind:event="oninput" />
                                        <div class="input-group input-group-sm" style="max-width:130px">
                                            <span class="input-group-text">+$</span>
                                            <input class="form-control" type="number" step="0.01" min="0"
                                                   @bind="_newOptPrice[groupIndex]" @bind:event="oninput" />
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                @onclick="() => AddOption(groupIndex)">Add</button>
                                    </div>
                                </div>
                            </div>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddGroup">
                            + Add Modifier Group
                        </button>
                    </div>

                    <hr />

                    @* ── Images ── *@
                    <h6 class="text-uppercase text-muted fw-bold mb-3">Images</h6>
                    <div class="row g-3">
                        @foreach (var slot in new[] {
                            (Index: 0, Label: "Main Image"),
                            (Index: 1, Label: "Image 2"),
                            (Index: 2, Label: "Image 3"),
                            (Index: 3, Label: "Image 4")
                        })
                        {
                            var s = slot;
                            var url = GetImageUrl(s.Index);
                            <div class="col-md-6">
                                <label class="form-label">@s.Label</label>
                                <div class="image-upload-field border rounded p-2">
                                    @if (!string.IsNullOrEmpty(url))
                                    {
                                        <div class="d-flex align-items-start gap-2 mb-2">
                                            <img src="@url" alt="@s.Label" class="img-thumbnail"
                                                 style="width:72px;height:72px;object-fit:cover;flex-shrink:0;" />
                                            <div class="flex-grow-1" style="min-width:0">
                                                <div class="d-flex align-items-center gap-1 mb-1">
                                                    <a href="@url" target="_blank" rel="noopener"
                                                       class="small text-muted text-truncate"
                                                       style="min-width:0" title="@url">@url</a>
                                                    <button type="button" class="btn btn-sm btn-link p-0 flex-shrink-0"
                                                            title="Copy URL"
                                                            @onclick="() => CopyUrlAsync(url)">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                                            <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/>
                                                            <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/>
                                                        </svg>
                                                    </button>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => ClearImage(s.Index)"
                                                        disabled="@_uploading.GetValueOrDefault(s.Index)">
                                                    Remove
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    <div class="d-flex align-items-center gap-2">
                                        <InputFile OnChange="e => UploadImageAsync(e, s.Index)"
                                                   accept="image/*"
                                                   class="form-control form-control-sm"
                                                   disabled="@_uploading.GetValueOrDefault(s.Index)" />
                                        @if (_uploading.GetValueOrDefault(s.Index))
                                        {
                                            <div class="spinner-border spinner-border-sm text-primary flex-shrink-0"
                                                 role="status" title="Uploading..."></div>
                                        }
                                    </div>
                                    @if (_uploadErrors.TryGetValue(s.Index, out var uploadErr))
                                    {
                                        <div class="text-danger small mt-1">@uploadErr</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                        @(_saving ? "Saving..." : "Save Item")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly JsonSerializerOptions _json = new() { PropertyNameCaseInsensitive = true };
    private static readonly string[] _commonAllergens = ["Gluten", "Dairy", "Eggs", "Nuts", "Fish", "Shellfish", "Soy", "Pork"];

    private string _userId = "";
    private bool _loading = true;
    private string? _error;
    private List<MenuItemEntity> _items = [];
    private List<string> _existingCategories = [];

    private bool _showModal;
    private bool _isNew;
    private bool _saving;
    private MenuItemDto? _editItem;
    private string? _confirmDeleteId;
    private string? _previewUrl;

    private string _newIngredient = "";
    private string _newAllergen = "";
    private Dictionary<int, string> _newOptName = new();
    private Dictionary<int, string> _newOptPrice = new();

    private Dictionary<int, bool> _uploading = new();
    private Dictionary<int, string> _uploadErrors = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = await Db.MenuItems
                .Where(m => m.AspNetUserId == _userId)
                .ToListAsync();
            _existingCategories = _items.Select(m => m.Category)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct().OrderBy(c => c).ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false;
    }

    private void OpenNew()
    {
        _isNew = true;
        _editItem = new MenuItemDto { Id = Guid.NewGuid().ToString(), IsAvailable = true };
        _newOptName.Clear();
        _newOptPrice.Clear();
        _uploading.Clear();
        _uploadErrors.Clear();
        _newIngredient = "";
        _newAllergen = "";
        _showModal = true;
    }

    private void OpenEdit(MenuItemEntity entity)
    {
        _isNew = false;
        _editItem = ToDto(entity);
        _newOptName.Clear();
        _newOptPrice.Clear();
        _uploading.Clear();
        _uploadErrors.Clear();
        _newIngredient = "";
        _newAllergen = "";
        for (int i = 0; i < _editItem.ModifierGroups.Count; i++)
        {
            _newOptName[i] = "";
            _newOptPrice[i] = "";
        }
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editItem = null;
    }

    private async Task SaveAsync()
    {
        if (_editItem is null) return;
        if (string.IsNullOrWhiteSpace(_editItem.Name) || string.IsNullOrWhiteSpace(_editItem.Category))
        {
            _error = "Name and Category are required.";
            return;
        }
        _saving = true;
        _error = null;
        try
        {
            var existing = await Db.MenuItems.FindAsync(_editItem.Id);
            if (existing is null)
            {
                Db.MenuItems.Add(ToEntity(_editItem));
            }
            else
            {
                ApplyToEntity(existing, _editItem);
                Db.MenuItems.Update(existing);
            }
            await Db.SaveChangesAsync();
            await LoadAsync();
            CloseModal();
        }
        catch (Exception ex) { _error = ex.Message; }
        _saving = false;
    }

    private async Task DeleteAsync(string id)
    {
        _confirmDeleteId = null;
        var entity = await Db.MenuItems.FindAsync(id);
        if (entity is null || entity.AspNetUserId != _userId) return;
        Db.MenuItems.Remove(entity);
        await Db.SaveChangesAsync();
        await LoadAsync();
    }

    // ── Ingredient / Allergen helpers ──────────────────────────────
    private void AddIngredient()
    {
        var val = _newIngredient.Trim();
        if (!string.IsNullOrEmpty(val) && _editItem is not null && !_editItem.Ingredients.Contains(val))
            _editItem.Ingredients.Add(val);
        _newIngredient = "";
    }

    private void AddAllergen()
    {
        var val = _newAllergen.Trim();
        if (!string.IsNullOrEmpty(val) && _editItem is not null && !_editItem.Allergens.Contains(val))
            _editItem.Allergens.Add(val);
        _newAllergen = "";
    }

    private void ToggleAllergen(string allergen)
    {
        if (_editItem is null) return;
        if (_editItem.Allergens.Contains(allergen)) _editItem.Allergens.Remove(allergen);
        else _editItem.Allergens.Add(allergen);
    }

    // ── Modifier group helpers ─────────────────────────────────────
    private void AddGroup()
    {
        if (_editItem is null) return;
        var idx = _editItem.ModifierGroups.Count;
        _editItem.ModifierGroups.Add(new ModifierGroupDto { Name = "", Required = false });
        _newOptName[idx] = "";
        _newOptPrice[idx] = "";
    }

    private void AddOption(int groupIndex)
    {
        if (_editItem is null || groupIndex >= _editItem.ModifierGroups.Count) return;
        var name = _newOptName.GetValueOrDefault(groupIndex, "").Trim();
        if (string.IsNullOrEmpty(name)) return;
        decimal.TryParse(_newOptPrice.GetValueOrDefault(groupIndex, "0"), out var price);
        _editItem.ModifierGroups[groupIndex].Options.Add(new ModifierOptionDto
        {
            Id = Guid.NewGuid().ToString(),
            Name = name,
            PriceModifier = price
        });
        _newOptName[groupIndex] = "";
        _newOptPrice[groupIndex] = "";
    }

    // ── Image upload helpers ───────────────────────────────────────
    private string? GetImageUrl(int slot) => slot switch
    {
        0 => _editItem?.MainImage,
        1 => _editItem?.Image1,
        2 => _editItem?.Image2,
        3 => _editItem?.Image3,
        _ => null
    };

    private void SetImageUrl(int slot, string? url)
    {
        if (_editItem is null) return;
        switch (slot)
        {
            case 0: _editItem.MainImage = url; break;
            case 1: _editItem.Image1 = url; break;
            case 2: _editItem.Image2 = url; break;
            case 3: _editItem.Image3 = url; break;
        }
    }

    private void ClearImage(int slot) => SetImageUrl(slot, null);

    private async Task CopyUrlAsync(string? url)
    {
        if (!string.IsNullOrEmpty(url))
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
    }

    private async Task UploadImageAsync(InputFileChangeEventArgs e, int slot)
    {
        if (_editItem is null) return;
        var file = e.File;
        _uploadErrors.Remove(slot);

        const long maxBytes = 10 * 1024 * 1024; // 10 MB
        if (file.Size > maxBytes)
        {
            _uploadErrors[slot] = "File must be under 10 MB.";
            return;
        }

        _uploading[slot] = true;
        StateHasChanged();

        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            var url = await BlobStorage.UploadImageAsync(
                stream, file.ContentType, _userId, _editItem.Name, file.Name);
            SetImageUrl(slot, url);
        }
        catch (Exception ex)
        {
            _uploadErrors[slot] = $"Upload failed: {ex.Message}";
        }

        _uploading[slot] = false;
        StateHasChanged();
    }

    // ── Entity ↔ DTO mapping ───────────────────────────────────────
    private MenuItemDto ToDto(MenuItemEntity e) => new()
    {
        Id = e.Id,
        Name = e.Name,
        Description = e.Description,
        Price = e.Price,
        Category = e.Category,
        IsAvailable = e.IsAvailable,
        MainImage = e.MainImage,
        Image1 = e.Image1,
        Image2 = e.Image2,
        Image3 = e.Image3,
        Ingredients = Deserialize<List<string>>(e.IngredientsJson),
        Allergens = Deserialize<List<string>>(e.AllergensJson),
        ModifierGroups = Deserialize<List<ModifierGroupDto>>(e.ModifierGroupsJson),
    };

    private MenuItemEntity ToEntity(MenuItemDto d)
    {
        var e = new MenuItemEntity { Id = d.Id, AspNetUserId = _userId };
        ApplyToEntity(e, d);
        return e;
    }

    private void ApplyToEntity(MenuItemEntity e, MenuItemDto d)
    {
        e.Name = d.Name;
        e.Description = d.Description;
        e.Price = d.Price;
        e.Category = d.Category;
        e.IsAvailable = d.IsAvailable;
        e.MainImage = d.MainImage;
        e.Image1 = d.Image1;
        e.Image2 = d.Image2;
        e.Image3 = d.Image3;
        e.IngredientsJson = JsonSerializer.Serialize(d.Ingredients);
        e.AllergensJson = JsonSerializer.Serialize(d.Allergens);
        e.ModifierGroupsJson = JsonSerializer.Serialize(d.ModifierGroups);
    }

    private T Deserialize<T>(string json) where T : new()
    {
        try { return JsonSerializer.Deserialize<T>(json, _json) ?? new T(); }
        catch { return new T(); }
    }
}
