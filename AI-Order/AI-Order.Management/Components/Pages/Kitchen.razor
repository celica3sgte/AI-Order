@page "/kitchen"
@attribute [Authorize]
@rendermode InteractiveServer
@using AI_Order.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using System.Text.Json
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpClientFactory HttpClientFactory
@implements IAsyncDisposable

<PageTitle>Kitchen Display</PageTitle>

<div class="kitchen-layout">

    <div class="kitchen-header">
        <h1 class="kitchen-title">Kitchen Orders</h1>
        <div class="kitchen-controls">
            <span class="kitchen-refresh-time">Updated: @_lastRefresh.ToString("h:mm:ss tt")</span>
            <button class="btn-kitchen-refresh" @onclick="LoadOrders" disabled="@_loading">
                @(_loading ? "Refreshing..." : "Refresh")
            </button>
        </div>
    </div>

    @if (_loading && !_orders.Any())
    {
        <div class="kitchen-empty">Loading orders...</div>
    }
    else if (!_orders.Any())
    {
        <div class="kitchen-empty">
            <div class="kitchen-empty-icon">&#10003;</div>
            <div>All clear — no active orders</div>
        </div>
    }
    else
    {
        <div class="kitchen-grid">
            @foreach (var order in _orders.OrderBy(o => o.CreatedAt))
            {
                <div class="kitchen-ticket @(IsNew(order) ? "ticket-new" : "")">
                    <div class="ticket-header">
                        <span class="ticket-table">@order.TableId</span>
                        <span class="ticket-time">@GetElapsed(order.CreatedAt)</span>
                    </div>

                    <span class="badge @StatusBadge(order.Status) mb-2">@order.Status</span>

                    <ul class="ticket-items">
                        @foreach (var item in order.LineItems)
                        {
                            <li class="ticket-item">
                                <span class="ticket-qty">@item.Quantity&#215;</span>
                                <div class="ticket-item-info">
                                    <span class="ticket-name">@item.Name</span>
                                    @if (item.SelectedModifiers.Any())
                                    {
                                        <span class="ticket-item-note">@string.Join(", ", item.SelectedModifiers)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.SpecialInstructions))
                                    {
                                        <span class="ticket-item-note">@item.SpecialInstructions</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>

                    @if (!string.IsNullOrEmpty(order.SpecialInstructions))
                    {
                        <div class="ticket-special">&#128203; @order.SpecialInstructions</div>
                    }

                    <div class="d-flex gap-2 mt-2">
                        @if (order.Status == OrderStatus.Submitted)
                        {
                            <button class="btn-done" @onclick="() => UpdateStatus(order, OrderStatus.InProgress)"
                                    disabled="@_updating.Contains(order.Id)">
                                Start
                            </button>
                        }
                        @if (order.Status == OrderStatus.InProgress)
                        {
                            <button class="btn-done" @onclick="() => UpdateStatus(order, OrderStatus.Ready)"
                                    disabled="@_updating.Contains(order.Id)">
                                Ready
                            </button>
                        }
                        @if (order.Status is OrderStatus.InProgress or OrderStatus.Ready)
                        {
                            <button class="btn-done" @onclick="() => UpdateStatus(order, OrderStatus.Completed)"
                                    disabled="@_updating.Contains(order.Id)">
                                Done
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private static readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };

    private string _userId = "";
    private List<TableOrder> _orders = [];
    private readonly HashSet<string> _updating = [];
    private DateTime _lastRefresh = DateTime.Now;
    private bool _loading;
    private Timer? _refreshTimer;
    private HttpClient _api = null!;

    protected override async Task OnInitializedAsync()
    {
        _api = HttpClientFactory.CreateClient("Api");
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        await LoadOrders();
        _refreshTimer = new Timer(async _ =>
        {
            await LoadOrders();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private async Task LoadOrders()
    {
        _loading = true;
        try
        {
            var all = await _api.GetFromJsonAsync<List<TableOrder>>(
                $"api/orders/byuser/{_userId}", _jsonOptions) ?? [];
            _orders = all.Where(o => o.Status is not OrderStatus.Completed and not OrderStatus.Cancelled).ToList();
            _lastRefresh = DateTime.Now;
        }
        catch { }
        finally
        {
            _loading = false;
        }
    }

    private async Task UpdateStatus(TableOrder order, OrderStatus newStatus)
    {
        _updating.Add(order.Id);
        StateHasChanged();

        using var resp = await _api.PatchAsJsonAsync(
            $"api/orders/{order.Id}/status",
            new UpdateOrderStatusRequest { AspNetUserId = _userId, Status = newStatus });

        if (resp.IsSuccessStatusCode)
        {
            if (newStatus is OrderStatus.Completed or OrderStatus.Cancelled)
                _orders.Remove(order);
            else
                order.Status = newStatus;
        }
        _updating.Remove(order.Id);
        StateHasChanged();
    }

    private static bool IsNew(TableOrder order) =>
        (DateTime.UtcNow - order.CreatedAt).TotalMinutes < 3;

    private static string GetElapsed(DateTime createdAt)
    {
        var elapsed = DateTime.UtcNow - createdAt;
        if (elapsed.TotalSeconds < 60) return "Just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes} min ago";
        return $"{(int)elapsed.TotalHours}h ago";
    }

    private static string StatusBadge(OrderStatus s) => s switch
    {
        OrderStatus.Submitted  => "bg-secondary",
        OrderStatus.InProgress => "bg-warning text-dark",
        OrderStatus.Ready      => "bg-info text-dark",
        _                      => "bg-light text-dark"
    };

    public async ValueTask DisposeAsync()
    {
        if (_refreshTimer is not null)
            await _refreshTimer.DisposeAsync();
    }
}
