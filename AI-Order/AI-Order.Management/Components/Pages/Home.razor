@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>AI Order</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="page-banner">
            <h1 class="page-banner-title">AI Order Management</h1>
            <p class="page-banner-sub">Real-time restaurant order management</p>
        </div>

        <div class="container-fluid py-4">
            <div class="row g-4 justify-content-center" style="max-width:900px; margin:0 auto;">

                <div class="col-12 col-md-6">
                    <a href="/dashboard" class="feature-card-link">
                        <div class="feature-card">
                            <div class="feature-card-header">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="white" viewBox="0 0 16 16">
                                    <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
                                </svg>
                                <span class="feature-card-title">DASHBOARD</span>
                            </div>
                            <div class="feature-card-body">
                                <svg class="feature-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                    <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"/>
                                </svg>
                                <p class="feature-card-desc">View and manage live orders in real-time. Update order status and track all active tables.</p>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-12 col-md-6">
                    <a href="/menu" class="feature-card-link">
                        <div class="feature-card">
                            <div class="feature-card-header">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="white" viewBox="0 0 16 16">
                                    <path d="M2 10.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5zm0-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm0-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5z"/>
                                </svg>
                                <span class="feature-card-title">MENU</span>
                            </div>
                            <div class="feature-card-body">
                                <svg class="feature-card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                    <path d="M2 10.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5zm0-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm0-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5z"/>
                                </svg>
                                <p class="feature-card-desc">Build and manage your restaurant's menu items, categories, modifiers, and pricing.</p>
                            </div>
                        </div>
                    </a>
                </div>

            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="home-hero">
            <div class="home-card">
                <div class="home-logo">AI Order</div>
                <p class="home-subtitle">Restaurant order management</p>
                <a class="btn btn-primary btn-lg w-100 mb-2" href="Account/Login">Sign In</a>
                <a class="btn btn-outline-secondary w-100" href="Account/Register">Create Account</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
